{
  // `target`, `module`, `moduleResolution`, `lib`, `allowJs`, `sourceMap`, `strict` and
  // `noEmit` used to sit at the top level of this file, where TypeScript ignores them, so
  // the project silently compiled on defaults. They are nested correctly now.
  "compilerOptions": {
    "target": "ES2018",
    // `node16` keeps the CommonJS emit this published package relies on (cypress has no
    // `"type": "module"`), without the `node10` resolution TypeScript 7 removes.
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ES2020",
      "ES2020.AsyncIterable",
      "DOM"
    ],
    "allowJs": true,
    "sourceMap": true,
    // TypeScript 6 enables `strict` by default. The `strict: true` above never applied, and
    // the specs do not compile under it yet, so keep the behaviour this code was written
    // against. Turning it on is a separate piece of work.
    "strict": false,
    "noEmit": false,
    "esModuleInterop": true,
    "types": [
      "cypress",
      "@cypress/grep",
      "cypress-axe"
    ],
    // Relative to this file, now that the deprecated `baseUrl` is gone.
    "paths": {
      "~/*": [
        "../*"
      ],
      "@/*": [
        "../*"
      ],
      "@shell/*": [
        "../shell/*"
      ],
      "@pkg/*": [
        "../shell/pkg/*"
      ],
      "@components/*": [
        "../pkg/rancher-components/src/components/*"
      ]
    },
  },
  "include": [
    "./**/*.ts",
    "../types/*.ts"
  ]
}
